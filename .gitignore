# Source-only repository. All other files remain local.
*
!*/
!.gitignore
!*.dart
!*.rs
!*.cpp
!*.cc
!*.h
!*.rc
!*.manifest
!*.cmake
!Cargo.toml
!Cargo.lock
!CMakeLists.txt
!pubspec.yaml
!pubspec.lock
!flutter_rust_bridge.yaml

# Local documents, assets, toolchains, dependencies and build outputs.
/docs/
/native/
/dist/
/.tools/
/.work/
/.qodo/
**/assets/
**/build/
**/target/
**/ephemeral/
**/.plugin_symlinks/
**/.dart_tool/
**/.gradle/
**/.kotlin/
**/.idea/
**/.vscode/
**/rust_builder/
**/test/failures/
**/test/goldens/
**/jniLibs/
**/.env*
**/local.properties
**/key.properties
**/GeneratedPluginRegistrant.java

!.gitattributes

# Repository introduction and project license.
!/README.md
!/LICENSE

# Windows-only public source tree; keep local tests and other targets private.
/apps/flutter_app/test/
/apps/flutter_app/integration_test/
/apps/flutter_app/android/
/apps/flutter_app/ios/
/apps/flutter_app/linux/
/apps/flutter_app/macos/
/apps/flutter_app/web/
/tests/
!/tools/build-windows.ps1
!/tools/setup-windows.ps1
!/tools/prepare-resources.py
!/tools/package-windows.py
!/tools/check-windows.ps1
!/rust-toolchain.toml

!/apps/flutter_app/analysis_options.yaml

# User-provided brand artwork is part of the application source.
!/apps/flutter_app/assets/
/apps/flutter_app/assets/*
!/apps/flutter_app/assets/branding/
!/apps/flutter_app/assets/branding/folinq.png
!/apps/flutter_app/windows/runner/resources/app_icon.ico
